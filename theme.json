{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "royal-blue",
          "name": "Royal Blue",
          "color": "#17458F"
        },
        {
          "slug": "gold",
          "name": "Gold",
          "color": "#F7A81B"
        },
        {
          "slug": "azure",
          "name": "Azure",
          "color": "#0067C8"
        },
        {
          "slug": "sky",
          "name": "Sky Blue",
          "color": "#00A2E0"
        },
        {
          "slug": "cranberry",
          "name": "Cranberry",
          "color": "#D41367"
        },
        {
          "slug": "cardinal",
          "name": "Cardinal",
          "color": "#E02927"
        },
        {
          "slug": "turquoise",
          "name": "Turquoise",
          "color": "#00ADBB"
        },
        {
          "slug": "violet",
          "name": "Violet",
          "color": "#901F93"
        },
        {
          "slug": "orange",
          "name": "Orange",
          "color": "#FF7600"
        },
        {
          "slug": "grass",
          "name": "Grass",
          "color": "#009739"
        },
        {
          "slug": "charcoal",
          "name": "Charcoal",
          "color": "#54565A"
        },
        {
          "slug": "pewter",
          "name": "Pewter",
          "color": "#898A8D"
        },
        {
          "slug": "smoke",
          "name": "Smoke",
          "color": "#B1B1B1"
        },
        {
          "slug": "silver",
          "name": "Silver",
          "color": "#D0CFCD"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#182B43"
        },
        {
          "slug": "paper",
          "name": "Paper",
          "color": "#FFFFFF"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#F2F5F9"
        }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1320px"
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "System Sans",
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        },
        {
          "slug": "display",
          "name": "Georgia",
          "fontFamily": "Georgia, serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "xs",
          "size": "0.8rem"
        },
        {
          "slug": "sm",
          "name": "sm",
          "size": "0.9rem"
        },
        {
          "slug": "base",
          "name": "base",
          "size": "1rem"
        },
        {
          "slug": "lg",
          "name": "lg",
          "size": "1.25rem"
        },
        {
          "slug": "xl",
          "name": "xl",
          "size": "1.65rem"
        },
        {
          "slug": "2xl",
          "name": "2xl",
          "size": "2.35rem"
        },
        {
          "slug": "3xl",
          "name": "3xl",
          "size": "3.5rem"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "10",
          "name": "10",
          "size": "clamp(0.375rem, 0.5vw, 0.5rem)"
        },
        {
          "slug": "20",
          "name": "20",
          "size": "clamp(0.5625rem, 0.75vw, 0.75rem)"
        },
        {
          "slug": "30",
          "name": "30",
          "size": "clamp(0.75rem, 1vw, 1rem)"
        },
        {
          "slug": "40",
          "name": "40",
          "size": "clamp(1.125rem, 1.5vw, 1.5rem)"
        },
        {
          "slug": "50",
          "name": "50",
          "size": "clamp(1.5rem, 2vw, 2rem)"
        },
        {
          "slug": "60",
          "name": "60",
          "size": "clamp(2.25rem, 3vw, 3rem)"
        },
        {
          "slug": "70",
          "name": "70",
          "size": "clamp(3rem, 4vw, 4rem)"
        },
        {
          "slug": "80",
          "name": "80",
          "size": "clamp(4.5rem, 6vw, 6rem)"
        }
      ],
      "defaultSpacingSizes": false
    },
    "custom": {
      "radius": {
        "card": "12px"
      },
      "motion": {
        "duration": "180ms",
        "easing": "ease-out"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|base",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|30"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "lineHeight": "1.15",
          "fontWeight": "700"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|royal-blue"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|royal-blue",
          "text": "var:preset|color|paper"
        },
        "border": {
          "radius": "6px"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "bottom": "0.8rem",
            "left": "1.3rem",
            "right": "1.3rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "header-transparent",
      "title": "Transparent Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-donate",
      "title": "Donate",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "donation-thank-you",
      "title": "Donation Thank You",
      "postTypes": [
        "page"
      ]
    }
  ]
}